{
  "name": "ManhwaFlare",
  "description": "Telegram manhwa bot — multi-source search, PDF chapters, premium plans, AI videos.",
  "repository": "https://github.com/EuthleXO/ManhwaFlare",
  "logo": "https://cdn-icons-png.flaticon.com/512/2111/2111646.png",
  "keywords": ["telegram", "bot", "manhwa", "manga", "mongodb", "heroku", "render", "python"],
  "success_url": "/",
  "env": {
    "BOT_TOKEN": {
      "description": "Telegram Bot Token from @BotFather",
      "required": true
    },
    "OWNER_ID": {
      "description": "Your Telegram numeric user id (co-owner 8681820826 is always included)",
      "required": true
    },
    "MONGODB_URI": {
      "description": "MongoDB Atlas connection string",
      "required": true
    },
    "DATABASE_NAME": {
      "description": "MongoDB database name",
      "value": "manhwaflare",
      "required": false
    },
    "LOG_CHANNEL_ID": {
      "description": "Telegram channel id for bot logs (bot must be admin)",
      "value": "-1003915347751",
      "required": false
    },
    "SUPPORT_GROUP": {
      "description": "Support group invite link",
      "value": "https://t.me/+CZCfHr3AHKUwNTJk",
      "required": false
    },
    "SUPPORT_CHANNEL": {
      "description": "Support channel username without @",
      "value": "DragonByte_network",
      "required": false
    },
    "OWNER_USERNAME": {
      "description": "Owner username without @",
      "value": "flexyy",
      "required": false
    },
    "CAPTION_TAG": {
      "description": "Default caption / filename tag",
      "value": "@ManhwaFlare",
      "required": false
    },
    "FILENAME_TEMPLATE": {
      "description": "PDF filename template",
      "value": "{chapter_num} ⌯ {manga_title} [{tag}]",
      "required": false
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "buildpacks": [
    { "url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg-latest.git" },
    { "url": "https://github.com/heroku/heroku-buildpack-apt.git" },
    { "url": "heroku/python" }
  ],
  "stack": "heroku-24"
}
